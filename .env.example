# คัดลอกเป็น .env แล้วกรอกค่า (ห้าม commit ไฟล์ .env)
ANTHROPIC_API_KEY=sk-ant-...

# --- เฉพาะ Telegram ---
TELEGRAM_BOT_TOKEN=            # ขอจาก @BotFather
TELEGRAM_OWNER_ID=             # user id ของคุณ (ถามบอท @userinfobot)

# --- ปรับแต่ง (ไม่ใส่ก็ได้) ---
# MODEL=claude-sonnet-5-5      # ถูกกว่า เหมาะกับงานทั่วไป (ค่าเริ่มต้น claude-opus-5-5)
# MAX_BUDGET_USD=2.0           # เพดานค่าใช้จ่ายต่อการรัน 1 ครั้ง
# AGENT_WORKDIR=/srv/agent     # โฟลเดอร์ที่ agent อ่าน/เขียนไฟล์ได้
